<mvc:View controllerName="com.zeim.fatturazionepassiva.controller.Archiviate"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:form="sap.ui.layout.form"
    xmlns:mdc="sap.ui.mdc"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:layout="sap.ui.layout"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:table="sap.ui.table"
    xmlns:sap.ui.fl="sap.ui.fl">
    <f:DynamicPage showFooter="true" fitContent="true" class="sapUiNoContentPadding">
        <!-- DynamicPage Header -->
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <fb:FilterBar useToolbar="false" showGoOnFB="true" showClearOnFB="true" isRunningInValueHelpDialog="false" search=".onFilterBarSearch" clear=".onFilterBarClear">
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem name="CompanyCode" label="Società" groupName="General" visibleInFilterBar="true">
                            <fb:control>
                                <Select id="archSelectSocieta" width="300px" forceSelection="false" items="{path:'MCSocieta>/ZR_EIM_COMPANY'}">
                                    <core:Item key="{MCSocieta>CompanyCode}" text="{MCSocieta>CompanyCode}" />
                                </Select>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem name="SupplierCode" label="Fornitore" groupName="General" visibleInFilterBar="true">
                            <fb:control>
                                <MultiInput id="archMultiInputFornitore" width="300px" showValueHelp="true" valueHelpRequest=".onValueHelpFornitoreArch" tokens="{archFilters>/SupplierTokens}">
                                    <tokens>
                                        <Token key="{archFilters>key}" text="{archFilters>text}" />
                                    </tokens>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem name="TipoDocAdE" label="Tipo doc. AdE" groupName="General" visibleInFilterBar="true">
                            <fb:control>
                                <MultiInput id="archMultiInputTipoDocAdE" width="300px" showValueHelp="true" valueHelpRequest=".onValueHelpTipoDocAdeArch" showSuggestion="true" suggestionItems="{path:'TipoDocAde>/ZC_EIM_BLADE'}">
                                    <suggestionItems>
                                        <core:Item key="{TipoDocAde>BlartAde}" text="{TipoDocAde>Descrizione}" />
                                    </suggestionItems>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem name="NumeroFattura" label="Nr. documento nel file XML" groupName="General" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="archInputNumeroFattura" width="300px" type="Text" />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem name="DataFattura" label="Data Documento" groupName="Date" visibleInFilterBar="true">
                            <fb:control>
                                <DateRangeSelection id="archDrsDataFattura" delimiter=" - " width="300px" displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd" />
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox height="90%">
                <OverflowToolbar style="Clear">
                    <content>
                        <Title text="Cruscotto fatture archiviate" />
                        <VariantManagement id="idVariantManagement" standardItemText="Standard" showSetAsDefault="true" save=".onVariantSave" select=".onVariantSelect" manage=".onVariantManage" />

                        <ToolbarSpacer />

                        <Button icon="sap-icon://action-settings" text="Layout colonne" press=".openPersoDialog" />
                        <Button icon="sap-icon://excel-attachment" text="Esporta Excel" press=".onExportExcel" />

                    </content>
                </OverflowToolbar>
                <ScrollContainer width="100%" height="100%" vertical="true" horizontal="true">
                    <Table id="fattureArchiviate" items="{fattureModel>/results}" mode="MultiSelect" selectionChange="onRowSelectionChange" class="sapUiNoMargin" width="120rem" sap.ui.fl:flexibility="sap/m/flexibility/EngineFlex">
                        <columns >
                            <Column width="7rem" hAlign="Begin">
                                <header>
                                    <Label text="Azioni" />
                                </header>
                            </Column>

                            <!-- <Column width="5rem">
                                <header>
                                    <Label text="XML" />
                                </header>
                            </Column>

                            <Column width="5rem">
                                <header>
                                    <Label text="Fattura" />
                                </header>
                            </Column> -->

                            <Column app:p13nKey="societa_col">
                                <header>
                                    <Label text="Società" />
                                </header>
                            </Column>

                            <Column app:p13nKey="Nomesocieta_col">
                                <header>
                                    <Label text="Nome società" />
                                </header>
                            </Column>

                            <Column app:p13nKey="fornitore_col">
                                <header>
                                    <Label text="Fornitore" />
                                </header>
                            </Column>

                            <Column app:p13nKey="NomeFornitore_col">
                                <header>
                                    <Label text="Nome fornitore" />
                                </header>
                            </Column>

                            <Column app:p13nKey="tipoAdE_col">
                                <header>
                                    <Label text="Tipo AdE" />
                                </header>
                            </Column>

                            <Column app:p13nKey="NumFattForn_col">
                                <header>
                                    <Label text="N. fattura fornitore" />
                                </header>
                            </Column>

                            <Column app:p13nKey="DataFatt_col">
                                <header>
                                    <Label text="Data fattura" />
                                </header>
                            </Column>

                            <Column app:p13nKey="NumDoc_col">
                                <header>
                                    <Label text="N. doc." />
                                </header>
                            </Column>

                            <Column app:p13nKey="Esercizio_col">
                                <header>
                                    <Label text="Esercizio" />
                                </header>
                            </Column>

                            <Column app:p13nKey="DocContabile_col">
                                <header>
                                    <Label text="Doc contabile" />
                                </header>

                            </Column>

                            <Column app:p13nKey="DataReg_col">
                                <header>
                                    <Label text="Data registr." />
                                </header>
                            </Column>

                            <Column app:p13nKey="TipoSap_col">
                                <header>
                                    <Label text="Tipo SAP" />
                                </header>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press=".onVisualizzaDati">
                                <HBox>
                                    <Button type="Transparent" icon="sap-icon://attachment" enabled="{= Boolean(${fattureModel>TipoAllegato}) &amp;&amp; ${fattureModel>TipoAllegato} !== '0' }" tooltip="{path: 'fattureModel>TipoAllegato', formatter: '.formatter.allegatoText'}" press=".onVisualizzaAllegato" />
                                    <Button type="Transparent" icon="sap-icon://show" press=".onVisualizzaXML" tooltip="Visualizza Fattura XML"/>
                                    <Button type="Transparent" icon="sap-icon://pdf-attachment" tooltip="Visualizza Fattura" press=".onVisualizzaPDF" />
                                </HBox>
                                <Text text="{fattureModel>CompanyCode}" />
                                <Text text="{fattureModel>CompanyName}" />
                                <Text text="{fattureModel>SupplierCode}" />
                                <Text text="{fattureModel>SupplierName}" />
                                <!-- <Text text="{fattureModel>TipoDocAdE}" /> -->
                                <ObjectIdentifier title="{fattureModel>TipoDocAdE}" text="{fattureModel>TipoDocText}"/>

                                <Text text="{fattureModel>NumeroFattura}" />
                                <Text text="{path:'fattureModel>DataFattura', formatter: '.formatter.formatDate'}" />
                                <Text text="{fattureModel>DocumentNumber}" />
                                <Text text="{fattureModel>FiscalYear}" />
                                <Text text="{fattureModel>FinanceDocument}" />
                                <Text text="{path:'fattureModel>PostingDate', formatter: '.formatter.formatDate'}" />
                                <Text text="{fattureModel>DocumentType}" />

                            </ColumnListItem>
                        </items>
                    </Table>
                </ScrollContainer>
            </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <Button icon="sap-icon://legend" type="Transparent" tooltip="Legenda icone" press=".onOpenLegendaPopover" />
                <ToolbarSpacer />
                <Button text="Ripristina Fatture" type="Emphasized" press=".onUnarchiveSelected" />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>