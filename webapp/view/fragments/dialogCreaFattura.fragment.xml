<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:u="sap.ui.unified">
    <Dialog title="Crea fattura" draggable="true" resizable="true" contentWidth="90%" contentHeight="85%">
        <content>
            <VBox>
                <fb:FilterBar persistencyKey="myPersKey" useToolbar="false" search=".onFilterBarSearch" showGoOnFB="true" showClearOnFB="true" clear=".onFilterBarClear" isRunningInValueHelpDialog="false">
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem name="Doc. Acquisto" label="Documento" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <Input />
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem name="Data" label="Data" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <DateRangeSelection delimiter=" - " width="300px" displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd" />

                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
                <ScrollContainer horizontal="true" vertical="false" width="100%">

                    <Table inset="false" width="100%" mode="MultiSelect" growing="true" sticky="ColumnHeaders" growingScrollToLoad="false" items="{ path: 'createInvoice>/data/purchaseOrders' }" selectionChange="onChangeSelectionCreateInvoice">
                        <columns>
                            <Column width="10rem">
                                <Text text="Doc. Acquisto" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Data ordine" />
                            </Column>
                            <Column width="10rem">
                                <Text text="N. posizioni" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Descrizione" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Importo ordine" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Importo da fatturare" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Divisa" />
                            </Column>
                            <Column width="10rem">
                                <Text text="Stato" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{createInvoice>purchaseOrder}" />
                                    <Text text="{path:'createInvoice>orderDate',formatter:'.formatter.formatDate'}" />
                                    <Text text="{createInvoice>positionsCount}" />
                                    <Text text="{createInvoice>description}" />
                                    <Text text="{createInvoice>orderAmount}" />
                                    <Text text="{createInvoice>amountToInvoice}" />
                                    <Text text="{createInvoice>currency}" />
                                    <Text text="{createInvoice>statusText}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </ScrollContainer>
            </VBox>
        </content>
        <beginButton>
            <Button text="Aggiungi" tooltip="Aggiungi" type="Emphasized" press="onAddRow" enabled="{= !!${createInvoice>/objSelected} &amp;&amp; ${createInvoice>/objSelected}.length > 0}" />
        </beginButton>
        <endButton>
            <Button text="Chiudi" press="onCloseUploadDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>