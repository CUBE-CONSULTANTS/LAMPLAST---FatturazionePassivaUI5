<mvc:View xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="com.zeim.fatturazionepassiva.controller.OrdineAcquistoDettaglio"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core">

    <uxap:ObjectPageLayout showFooter="true" showTitleInHeaderContent="true" alwaysShowContentHeader="false" preserveHeaderStateOnScroll="false" headerContentPinnable="true" isChildPage="true" upperCaseAnchorBar="false">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <m:HBox width="100%" justifyContent="SpaceBetween" alignItems="Center">
                        <m:Title text="Crea fattura" wrapping="true" />
                    </m:HBox>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <m:FlexBox fitContainer="true" alignItems="Center">
                        <m:Title text="Crea fattura" wrapping="true" />
                    </m:FlexBox>
                </uxap:snappedHeading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:sections>

            <!-- SEZIONE DATI TESTATA -->
            <uxap:ObjectPageSection title="Dati testata">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <form:Form editable="false" width="100%">
                                <form:layout>
                                    <form:ResponsiveGridLayout labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="4" columnsL="3" columnsM="2" singleContainerFullSize="false" />
                                </form:layout>
                                <form:formContainers>

                                    <!-- DOCUMENTO -->
                                    <form:FormContainer title="Documento">
                                        <form:formElements>
                                            <form:FormElement label="Società">
                                                <m:Text text="{CompanyCode}" />
                                            </form:FormElement>
                                            <form:FormElement label="Nome società">
                                                <m:Text text="{CompanyName}" />
                                            </form:FormElement>
                                            <form:FormElement label="Tipo Doc. AdE">
                                                <m:Text text="{TipoDocAdE}" />
                                            </form:FormElement>
                                            <form:FormElement label="Descrizione Tipo Doc.">
                                                <m:Text text="{TipoDocText}" />
                                            </form:FormElement>
                                            <form:FormElement label="Tipo fattura">
                                                <m:Text text="{= ${TipoFattura} === 'M' ? 'Fattura Logistica' : 'Fattura Contabile' }" />
                                            </form:FormElement>
                                            <form:FormElement label="Esercizio">
                                                <m:Text text="{FiscalYear}" />
                                            </form:FormElement>
                                            <form:FormElement label="Tipo documento SAP">
                                                <m:Text text="{DocumentType}" />
                                            </form:FormElement>
                                            <form:FormElement label="Doc. contabile">
                                                <m:Link text="{FinanceDocument}" press="onFinanceDocumentLinkPress" />
                                            </form:FormElement>
                                            <form:FormElement label="Data registrazione">
                                                <m:Text text="{path: 'PostingDate', formatter: '.formatter.formatDate'}" />
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>

                                    <form:FormContainer title="Fornitore" visible="{= !!${SelectedSupplierCode}}">
                                        <form:formElements>
                                            <form:FormElement label="Codice">
                                                <m:Link text="{= ${SelectedSupplierCode} ? ${SelectedSupplierCode} : ${SupplierCode} }" press="onNavToFornitore" />
                                            </form:FormElement>
                                            <form:FormElement label="Nome">
                                                <m:Text text="{SupplierName}" />
                                            </form:FormElement>
                                            <form:FormElement label="Partita IVA">
                                                <m:Text text="{PartitaIVAcee}" />
                                            </form:FormElement>
                                            <form:FormElement label="Codice fiscale">
                                                <m:Text text="{CodiceFiscale}" />
                                            </form:FormElement>
                                            <form:FormElement label="N. fattura fornitore">
                                                <m:Text text="{NumeroFattura}" />
                                            </form:FormElement>
                                            <form:FormElement label="Data fattura">
                                                <m:Text text="{path: 'DataFattura', formatter: '.formatter.formatDate'}" />
                                            </form:FormElement>
                                            <form:FormElement label="Causale">
                                                <m:Text text="{Causale}" />
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>

                                    <!-- SDI E STATO -->
                                    <form:FormContainer title="SDI e Stato">
                                        <form:formElements>
                                            <form:FormElement label="Codice destinatario">
                                                <m:Text text="{CodDestinatario}" />
                                            </form:FormElement>
                                            <form:FormElement label="Numero SDI">
                                                <m:Text text="{NumeroSDI}" />
                                            </form:FormElement>
                                            <form:FormElement label="Data ricezione SDI">
                                                <m:Text text="{path: 'DataSDI', formatter: '.formatter.formatDate'}" />
                                            </form:FormElement>
                                            <form:FormElement label="Paese">
                                                <m:Text text="{Paese}" />
                                            </form:FormElement>
                                            <form:FormElement label="Blocco">
                                                <m:Text text="{= ${CodBlocco} ? 'Bloccato' : 'Sbloccato' }" />
                                            </form:FormElement>
                                            <form:FormElement label="Motivo blocco">
                                                <m:Text text="{MotivoBlocco}" />
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>

                                    <!-- IMPORTI -->
                                    <form:FormContainer title="Importi">
                                        <form:formElements>
                                            <form:FormElement label="Imponibile">
                                                <m:Text text="{Imponibile}" />
                                            </form:FormElement>
                                            <form:FormElement label="Totale">
                                                <m:Text text="{Totale}" />
                                            </form:FormElement>
                                            <form:FormElement label="Divisa">
                                                <m:Text text="{Divisa}" />
                                            </form:FormElement>
                                            <form:FormElement label="Data pagamento">
                                                <m:Text text="{path: 'DataPagamento', formatter: '.formatter.formatDate'}" />
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>

                                </form:formContainers>
                            </form:Form>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- SEZIONE DETTAGLIO RIGHE -->
            <uxap:ObjectPageSection title="Dettaglio righe">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <m:ScrollContainer horizontal="true" vertical="false" width="100%" focusable="true">
                                <table:Table rows="{
                                            path: '/row',
                                            sorter:{ path: 'positionsCount'}
                                    }" selectionMode="None" enableColumnReordering="false" width="100%">
                                    <table:extension>
                                        <m:OverflowToolbar>
                                            <m:ToolbarSpacer />
                                            <m:Button icon="sap-icon://add" tooltip="Aggiunti" type="Emphasized" press=".onOpenDialogForAdd" />
                                            <!-- <m:Button icon="sap-icon://add" tooltip="Cancella" type="Emphasized" press=".onOpenDialogForAdd" /> -->

                                        </m:OverflowToolbar>
                                    </table:extension>
                                    <table:rowMode>
                                        <rowmodes:Auto rowContentHeight="48" minRowCount="5"/>
                                    </table:rowMode>
                                    <table:columns>

                                        <table:Column width="5rem">
                                            <table:label>
                                                <m:Label text="Posizione" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{positionsCount}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="8rem">
                                            <table:label>
                                                <m:Label text="Codice materiale" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{material}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="20rem">
                                            <table:label>
                                                <m:Label text="Descrizione materiale" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{description}" wrapping="true" wrappingType="Hyphenated"/>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="5rem">
                                            <table:label>
                                                <m:Label text="UM" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{unit}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="8rem" hAlign="End">
                                            <table:label>
                                                <m:Label text="Qtà ordinata" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{path: 'qtyOrdered', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="8rem" hAlign="End">
                                            <table:label>
                                                <m:Label text="Qtà ricevuta (EM)" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{path: 'qtyReceived', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="8rem" hAlign="End">
                                            <table:label>
                                                <m:Label text="Qtà già fatturata" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{path: 'qtyInvoiced', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="8rem" hAlign="End">
                                            <table:label>
                                                <m:Label text="Qtà residua" />
                                            </table:label>
                                            <table:template>
                                                <m:ObjectNumber number="{path: 'qtyOpen', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}" emphasized="true" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem" hAlign="End">
                                            <table:label>
                                                <m:Label text="Prezzo unitario" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{path: 'unitPrice', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="8rem" hAlign="End">
                                            <table:label>
                                                <m:Label text="Importo residuo" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{path: 'amountOpen', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="5rem">
                                            <table:label>
                                                <m:Label text="Cod. IVA" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{taxCode}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <!-- CONFRONTO CON LA FATTURA XML -->
                                        <table:Column width="7rem">
                                            <table:label>
                                                <m:Label text="Pos. fattura XML" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{= ${matchedXmlPosition} ? ${matchedXmlPosition} : '-' }" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem" hAlign="End">
                                            <table:label>
                                                <m:Label text="Prezzo XML" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{= ${prezzoXml} === null || ${prezzoXml} === undefined ? '-' : ${prezzoXml} }" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem" hAlign="End">
                                            <table:label>
                                                <m:Label text="Delta prezzo" />
                                            </table:label>
                                            <table:template>
                                                <m:ObjectStatus text="{= ${deltaPrezzo} === null || ${deltaPrezzo} === undefined ? '-' : ${deltaPrezzo} }" state="{= ${deltaPrezzo} ? 'Error' : 'None' }" />
                                            </table:template>
                                        </table:Column>

                                    </table:columns>
                                </table:Table>
                            </m:ScrollContainer>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>

        <uxap:footer>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                <!-- <m:Button text="Seleziona questo ordine" tooltip="Seleziona questo ordine" icon="sap-icon://accept" type="Emphasized" press=".onSelezionaOrdine" enabled="{ordine>/selectable}" /> -->
                <m:Button text="Indietro" tooltip="Indietro" icon="sap-icon://nav-back" press=".onNavBack" />
            </m:OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>