<mvc:View xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="com.zeim.fatturazionepassiva.controller.Dettaglio"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core">
    <!-- <m:Page id="paginaDettaglio" showFooter="true" class="sapUiSizeCompact">
        <m:content> -->
    <uxap:ObjectPageLayout id="objectPageLayout" showFooter="true" showTitleInHeaderContent="true" alwaysShowContentHeader="false" preserveHeaderStateOnScroll="false" headerContentPinnable="true" isChildPage="true" upperCaseAnchorBar="false">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <m:HBox width="100%" justifyContent="SpaceBetween" alignItems="Center">
                        <!-- NumeroFattura  -->
                        <m:Title text='Fattura {fattura>/FatturaElettronicaBody/DatiGenerali/DatiGeneraliDocumento/Numero}' wrapping="true" />
                    </m:HBox>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <m:FlexBox fitContainer="true" alignItems="Center">
                        <m:Title text='Fattura {fattura>/FatturaElettronicaBody/DatiGenerali/DatiGeneraliDocumento/Numero}' wrapping="true" />
                    </m:FlexBox>
                </uxap:snappedHeading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:sections>
            <!-- SEZIONE DATI TESTATA -->
            <uxap:ObjectPageSection id="datiTestataSection" title="Dati testata">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <form:Form editable="false" width="100%">
                                <form:layout>
                                    <form:ResponsiveGridLayout labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="4" columnsL="3" columnsM="2" singleContainerFullSize="false" />
                                </form:layout>
                                <form:formContainers>

                                    <!-- DOCUMENTO -->
                                    <form:FormContainer title="Documento">
                                        <form:formElements>
                                            <form:FormElement label="Società">
                                                <m:Text text="{CompanyCode}" />
                                            </form:FormElement>
                                            <form:FormElement label="Nome società">
                                                <m:Text text="{CompanyName}" />
                                            </form:FormElement>
                                            <form:FormElement label="Tipo Doc. AdE">
                                                <m:Text text="{TipoDocAdE}" />
                                            </form:FormElement>
                                            <form:FormElement label="Descrizione Tipo Doc.">
                                                <m:Text text="{TipoDocText}" />
                                            </form:FormElement>
                                            <form:FormElement label="Tipo fattura">
                                                <m:Text text="{= ${TipoFattura} === 'M' ? 'Fattura Logistica' : 'Fattura Contabile' }" />
                                            </form:FormElement>
                                            <form:FormElement label="Esercizio">
                                                <m:Text text="{FiscalYear}" />
                                            </form:FormElement>
                                            <form:FormElement label="Tipo documento SAP">
                                                <m:Text text="{DocumentType}" />
                                            </form:FormElement>
                                            <form:FormElement label="Doc. contabile">
                                                <m:Link text="{FinanceDocument}" press="onFinanceDocumentLinkPress" />
                                            </form:FormElement>
                                            <form:FormElement label="Data registrazione">
                                                <m:Text text="{path: 'PostingDate', formatter: '.formatter.formatDate'}" />
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>

                                    <form:FormContainer title="Fornitore" visible="{= !!${SelectedSupplierCode}}">
                                        <form:formElements>
                                            <form:FormElement label="Codice">
                                                <m:Link text="{= ${SelectedSupplierCode} ? ${SelectedSupplierCode} : ${SupplierCode} }" press="onNavToFornitore" />
                                            </form:FormElement>
                                            <form:FormElement label="Nome">
                                                <m:Text text="{SupplierName}" />
                                            </form:FormElement>
                                            <form:FormElement label="Partita IVA">
                                                <m:Text text="{PartitaIVAcee}" />
                                            </form:FormElement>
                                            <form:FormElement label="Codice fiscale">
                                                <m:Text text="{CodiceFiscale}" />
                                            </form:FormElement>
                                            <form:FormElement label="N. fattura fornitore">
                                                <m:Text text="{NumeroFattura}" />
                                            </form:FormElement>
                                            <form:FormElement label="Data fattura">
                                                <m:Text text="{path: 'DataFattura', formatter: '.formatter.formatDate'}" />
                                            </form:FormElement>
                                            <form:FormElement label="Causale">
                                                <m:Text text="{Causale}" />
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>

                                    <!-- SDI E STATO -->
                                    <form:FormContainer title="SDI e Stato">
                                        <form:formElements>
                                            <form:FormElement label="Codice destinatario">
                                                <m:Text text="{CodDestinatario}" />
                                            </form:FormElement>
                                            <form:FormElement label="Numero SDI">
                                                <m:Text text="{NumeroSDI}" />
                                            </form:FormElement>
                                            <form:FormElement label="Data ricezione SDI">
                                                <m:Text text="{path: 'DataSDI', formatter: '.formatter.formatDate'}" />
                                            </form:FormElement>
                                            <form:FormElement label="Paese">
                                                <m:Text text="{Paese}" />
                                            </form:FormElement>
                                            <form:FormElement label="Blocco">
                                                <m:Text text="{= ${CodBlocco} ? 'Bloccato' : 'Sbloccato' }" />
                                            </form:FormElement>
                                            <form:FormElement label="Motivo blocco">
                                                <m:Text text="{MotivoBlocco}" />
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>

                                    <!-- IMPORTI -->
                                    <form:FormContainer title="Importi">
                                        <form:formElements>
                                            <form:FormElement label="Imponibile">
                                                <m:Text text="{Imponibile}" />
                                            </form:FormElement>
                                            <form:FormElement label="Totale">
                                                <m:Text text="{Totale}" />
                                            </form:FormElement>
                                            <form:FormElement label="Divisa">
                                                <m:Text text="{Divisa}" />
                                            </form:FormElement>
                                            <form:FormElement label="Data pagamento">
                                                <m:Text text="{path: 'DataPagamento', formatter: '.formatter.formatDate'}" />
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>

                                </form:formContainers>
                            </form:Form>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- SEZIONE DETTAGLIO RIGHE -->
            <uxap:ObjectPageSection id="dettaglioRigheSection" title="Dettaglio righe">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <m:ScrollContainer horizontal="true" vertical="false" width="100%" focusable="true">
                                <table:Table rows="{fattura>/FatturaElettronicaBody/DatiBeniServizi/DettaglioLinee}" selectionMode="None" enableColumnReordering="false" width="100%">
                                    <table:rowMode>
                                        <!-- <rowmodes:Fixed xmlns:rowmodes="sap.ui.table.rowmodes" rowCount="10" /> -->
                                        <rowmodes:Auto rowContentHeight="64" minRowCount="10"/>
                                    </table:rowMode>
                                    <table:columns>

                                        <table:Column width="6rem">
                                            <table:label>
                                                <m:Label text="Posizione" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{fattura>NumeroLinea}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="6rem">
                                            <table:label>
                                                <m:Label text="M.For/CACC" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{matFornCcac}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem" visible="{= ${viewModel>/ui/mode} === 'edit' }">
                                            <table:label>
                                                <m:Label text="Codice Materiale SAP" wrapping="true" />
                                            </table:label>
                                            <table:template>
                                                <m:VBox renderType="Bare">
                                                    <m:Input value="{materialCode}" valueState="{= ${materialCode} ? 'Success' : 'Error' }" visible="{= ${viewModel>/ui/mode} === 'edit' &amp;&amp; (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0 }" width="100%" />
                                                    <!-- <m:Text text="{materialCode}" /> -->
                                                </m:VBox>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="20rem">
                                            <table:label>
                                                <m:Label text="Testo riga fattura" wrapping="true" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{fattura>Descrizione}" wrapping="true" wrappingType="Hyphenated"/>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="8rem" visible="{= ${viewModel>/ui/mode} === 'edit' }">
                                            <table:label>
                                                <m:Label text="Unità di misura" />
                                            </table:label>
                                            <table:template>
                                                <m:VBox renderType="Bare">
                                                    <m:Input value="{fattura>UnitaMisura}" valueState="{= ${fattura>UnitaMisura} ? 'Success' : 'Error' }" visible="{= ${viewModel>/ui/mode} === 'edit' &amp;&amp; (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0 }" width="100%" />
                                                    <!-- <m:Text text="{fattura>UnitaMisura}" visible="{= ${viewModel>/ui/mode} !== 'edit' }" /> -->
                                                </m:VBox>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="6rem">
                                            <table:label>
                                                <m:Label text="Quantità" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{fattura>Quantita}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="6rem">
                                            <table:label>
                                                <m:Label text="Prezzo Unitario" wrapping="true"/>
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{fattura>PrezzoUnitario}" visible="{= (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem">
                                            <table:label>
                                                <m:Label text="Prezzo Totale" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{fattura>PrezzoTotale}" visible="{= (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="5rem">
                                            <table:label>
                                                <m:Label text="Cod. IVA (%)" wrapping="true"/>
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{fattura>AliquotaIVA}" wrapping="false" visible="{= (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0}"/>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="6rem" hAlign="Center" visible="{= ${viewModel>/ui/mode} === 'edit'}">
                                            <table:label>
                                                <m:Label text="Assegna documenti SAP" wrapping="true" />
                                            </table:label>
                                            <table:template>
                                                <m:Button icon="sap-icon://action" tooltip="Assegna documenti SAP" press="onOpenDialogAssignSAPDocument" visible="{= (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0 }" enabled="{= ${viewModel>/ui/mode} === 'edit' }" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem">
                                            <table:label>
                                                <m:Label text="Doc. Acquisto" />
                                            </table:label>
                                            <table:template>
                                                <m:Link text="{fattura>odaIdDocumento}" tooltip="{fattura>odaIdDocumento}" press="navToOrdineAcquisto" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="7rem">
                                            <table:label>
                                                <m:Label text="Data Doc." />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{path:'fattura>odaDataDoc', formatter:'.formatter.formatDate'}" wrapping="false" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="7rem" visible="{= ${viewModel>/ui/mode} === 'edit' }">
                                            <table:label>
                                                <m:Label text="OdA SAP" />
                                            </table:label>
                                            <table:template>
                                                <m:VBox renderType="Bare">
                                                    <!-- Cambiare il -->
                                                    <m:Input value="{fattura>OdaSap}" valueState="{= ${fattura>OdaSap} ? 'Success' : 'Error' }" visible="{= ${viewModel>/ui/mode} === 'edit' &amp;&amp; (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0 }" width="100%" />
                                                    <!-- <m:Text text="{fattura>OdaSap}" visible="{= ${viewModel>/ui/mode} !== 'edit' }" /> -->
                                                </m:VBox>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem" visible="{= ${viewModel>/ui/mode} === 'edit' }">
                                            <table:label>
                                                <m:Label text="Posizione Oda" />
                                            </table:label>
                                            <table:template>
                                                <m:VBox renderType="Bare">
                                                    <m:Input value="{fattura>odaPosOda}" valueState="{= ${fattura>odaPosOda} ? 'Success' : 'Error' }" visible="{= ${viewModel>/ui/mode} === 'edit' &amp;&amp; (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0 }" width="100%" />
                                                    <!-- <m:Text text="{fattura>odaPosOda}" visible="{= ${viewModel>/ui/mode} !== 'edit' }" /> -->
                                                </m:VBox>
                                            </table:template>
                                        </table:Column>




                                        <table:Column width="7rem" visible="{= ${viewModel>/ui/mode} === 'edit' }">
                                            <table:label>
                                                <m:Label text="Doc. Mat./SES" />
                                            </table:label>
                                            <table:template>
                                                <m:VBox renderType="Bare">
                                                    <m:Input value="{docMat}" valueState="{= ${docMat} ? 'Success' : 'Error' }" visible="{= ${viewModel>/ui/mode} === 'edit' &amp;&amp; (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0 }" width="100%" />
                                                    <!-- <m:Text text="{docMat}" visible="{= ${viewModel>/ui/mode} !== 'edit' }" /> -->
                                                </m:VBox>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="5rem" visible="{= ${viewModel>/ui/mode} === 'edit' }">
                                            <table:label>
                                                <m:Label text="Posizione" />
                                            </table:label>
                                            <table:template>
                                                <m:VBox renderType="Bare">
                                                    <m:Input value="{posDocMat}" valueState="{= ${posDocMat} ? 'Success' : 'Error' }" visible="{= ${viewModel>/ui/mode} === 'edit' &amp;&amp; (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0 }" width="100%" />
                                                    <!-- <m:Text text="{posDocMat}" visible="{= ${viewModel>/ui/mode} !== 'edit' }" /> -->
                                                </m:VBox>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem" visible="{= ${viewModel>/ui/mode} === 'edit' }">
                                            <table:label>
                                                <m:Label text="Es.doc.mat" />
                                            </table:label>
                                            <table:template>
                                                <m:VBox renderType="Bare">
                                                    <m:Input value="{esDocMat}" valueState="{= ${esDocMat} ? 'Success' : 'Error' }" visible="{= ${viewModel>/ui/mode} === 'edit' &amp;&amp; (parseFloat(${fattura>Quantita}) || 0) !== 0 &amp;&amp; (parseFloat(${fattura>PrezzoUnitario}) || 0) !== 0 }" width="100%" />
                                                    <!-- <m:Text text="{esDocMat}" visible="{= ${viewModel>/ui/mode} !== 'edit' }" /> -->
                                                </m:VBox>
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="4rem">
                                            <table:label>
                                                <m:Label text="CUP" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{cup}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="4rem">
                                            <table:label>
                                                <m:Label text="CIG" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{cig}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="6rem">
                                            <table:label>
                                                <m:Label text="Commessa" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{commessa}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem">
                                            <table:label>
                                                <m:Label text="Bolla consegna" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{fattura>NumeroDDT}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem">
                                            <table:label>
                                                <m:Label text="Data bolla consegna" wrapping="true"/>
                                            </table:label>
                                            <table:template>
                                                <m:Text text="{path:'fattura>DataDDT',formatter:'.formatter.formatDate'}" wrapping="false" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem">
                                            <table:label>
                                                <m:Label text="Data di registrazione" wrapping="true"/>
                                            </table:label>
                                            <table:template>
                                                <m:Text text="-" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="7rem">
                                            <table:label>
                                                <m:Label text="N. Doc" />
                                            </table:label>
                                            <table:template>
                                                <m:Text text="-" />
                                            </table:template>
                                        </table:Column>

                                    </table:columns>
                                </table:Table>
                            </m:ScrollContainer>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
        <uxap:footer>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />

                <m:Button text="Crea fattura da dati xml" tooltip="Crea fattura da dati xml" icon="sap-icon://attachment-html" type="Emphasized" press=".onPreAcquisireFile" visible="{= ${viewModel>/ui/mode} === 'edit' }" />
                <m:Button text="Crea fattura da dati SAP" tooltip="Crea fattura da dati SAP" icon="sap-icon://download" type="Emphasized" press=".onCreaFatturaDaSAP" visible="{= ${viewModel>/ui/mode} === 'edit' }" />

                <m:Button icon="sap-icon://decline" text="Annulla / Esci" press="onBackToHome" />
            </m:OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
    <!-- </m:content> -->


    <!-- </m:Page> -->
</mvc:View>
